# Servidor do playground. A mesma config vale no container local e na VM;
# so o endereco muda (`:8080` -> `lume.seu-dominio` para HTTPS automatico).
:8080 {
	root * /srv
	encode zstd gzip

	header {
		# Necessarios para SharedArrayBuffer (stdin interativo, Fase 1.5).
		# Custo: embeds de terceiros sem CORP passam a ser bloqueados.
		Cross-Origin-Opener-Policy   same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options       nosniff
	}

	# Sem "immutable" enquanto os nomes nao carregarem hash de conteudo: como
	# lume.wasm mantem o mesmo nome a cada build, marcar imutavel faz o
	# navegador servir o binario velho por um ano. Quando o bundle passar a
	# gerar lume.<hash>.wasm, ai sim vale o cache longo.
	header Cache-Control "no-cache"

	file_server
}
